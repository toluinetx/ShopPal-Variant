# Example environment file for `server`. Copy to `.env` and fill in real values.
# The credentials below are MOCK placeholders (correctly formatted, non-functional)
# meant only to illustrate the expected shape of each variable.

NODE_ENV=development
DB_CONNECTION_URL=postgres://shoppal:change-me@localhost:5432/shoppal
CLIENT_PROD_URL=http://localhost:8087
ADMIN_PROD_URL=http://localhost:8090

JWT_SECRET=change-me-dev-only-not-for-prod
JWT_ACCESS_TOKEN_LENGTH=15m
JWT_REFRESH_TOKEN_LENGTH=7d
COOKIE_REFRESH_TOKEN_NAME=refreshToken
COOKIE_REFRESH_TOKEN_AGE=604800000
BCRYPT_HASH_LENGTH=10

NOTIFICATIONS_URL=http://localhost:8082

